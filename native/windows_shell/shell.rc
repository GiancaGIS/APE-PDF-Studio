#include <windows.h>
#include <commctrl.h>
#include "metadata_resources.h"

IDD_PDF_METADATA DIALOGEX 0, 0, 260, 248
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_METADATA_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 8, 244, 162
    EDITTEXT IDC_METADATA_VALUE, 8, 176, 244, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT "", IDC_METADATA_STATUS, 8, 227, 125, 16
    PUSHBUTTON "", IDC_METADATA_OPEN, 138, 225, 114, 18
END
